# Use specific Node.js version
FROM node:20.16.0

# Set working directory inside container
WORKDIR /app

# Copy package files first (for caching)
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of your project
COPY . .

# Expose your app port (adjust if needed)
EXPOSE 3000

# Start the app
CMD ["npm", "start"]